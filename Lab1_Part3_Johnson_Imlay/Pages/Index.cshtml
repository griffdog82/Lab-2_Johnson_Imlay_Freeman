@page
@model Lab1_Part3_Johnson_Imlay.Pages.IndexModel
@{
    ViewData["Title"] = "User List";
}

<div class="container mt-4">
    <p class="text-muted">Developed by <strong>Griffin Imlay, Nicole Johnson, Zachary Freeman</strong></p>

    <h2 class="mb-4">Index Dashboard</h2>
    <ul class="list-group mb-4">
        <li class="list-group-item">
            <a asp-page="/Admin/Admin_Dashboard" class="text-primary">Admin Dashboard</a>
            <span class="text-muted">(What an Admin would see)</span>
        </li>
        <li class="list-group-item">
            <a asp-page="/Faculty/FacultyDashboard" class="text-primary">Faculty Dashboard</a>
            <span class="text-muted">(What a Faculty Member would see)</span>
        </li>
        <li class="list-group-item">
            <a asp-page="/BusinessPartner/BusinessPartner_Dashboard" class="text-primary">Business Partner Dashboard</a>
            <span class="text-muted">(What a Business Partner would see)</span>
        </li>
    </ul>

    <h2 class="mb-3">At-a-Glance Overview</h2>

    <div class="mb-4">
        <h3 class="mb-3">Grants Summary</h3>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Grant Name</th>
                    <th>Category</th>
                    <th>Funding Source</th>
                    <th>Lead Faculty</th>
                    <th>Submission Date</th>
                    <th>Award Date</th>
                    <th>Amount ($)</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grant in Model.Grants)
                {
                    <tr>
                        <td>@grant.GrantName</td>
                        <td>@grant.Category</td>
                        <td>@grant.FundingSource</td>
                        <td>@grant.LeadFacultyName</td>
                        <td>@grant.SubmissionDate.ToString("yyyy-MM-dd")</td>
                        <td>@(grant.AwardDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                        <td>@grant.Amount.ToString("C")</td>
                        <td>
                            <span class="badge @(grant.Status == "Approved" ? "bg-success" : grant.Status == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                                @grant.Status
                            </span>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <div>
        <h3 class="mb-3">Projects Summary</h3>
        <table class="table table-striped table-bordered">
            <thead class="table-dark">
                <tr>
                    <th>Project Title</th>
                    <th>Due Date</th>
                    <th>Created By</th>
                    <th>Business Partner</th>
                    <th>Grant</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var project in Model.Projects)
                {
                    <tr>
                        <td>@project.Title</td>
                        <td>@project.DueDate.ToString("yyyy-MM-dd")</td>
                        <td>@project.CreatedByName</td>
                        <td>@project.BusinessPartnerName</td>
                        <td>@(project.GrantName ?? "N/A")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
