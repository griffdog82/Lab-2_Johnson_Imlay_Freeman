@page
@model Lab1_Part3_Johnson_Imlay.Pages.BusinessPartner.AddMeetingMinutesModel
@{
    ViewData["Title"] = "Add Meeting Minutes";
}

<div class="container mt-4">
    <h2 class="mb-3 text-center">➕ Add Meeting Minutes</h2>

    <form method="post">
        <div asp-validation-summary="All" class="text-danger"></div>

        <div class="form-group">
            <label for="businessPartnerID">Business Partner</label>
            <select asp-for="MeetingMinute.BusinessPartnerID" class="form-select">
                <option value="">Select a Business Partner</option>
                @foreach (var partner in Model.BusinessPartners)
                {
                    <option value="@partner.BusinessPartnerID">@partner.Name</option>
                }
            </select>
            <span asp-validation-for="MeetingMinute.BusinessPartnerID" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="representativeID">Representative</label>
            <select asp-for="MeetingMinute.RepresentativeID" class="form-select">
                <option value="">Select a Representative</option>
                @foreach (var user in Model.Representatives)
                {
                    <option value="@user.UserID">@user.FullName</option>
                }
            </select>
            <span asp-validation-for="MeetingMinute.RepresentativeID" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="meetingWithID">Meeting With</label>
            <select asp-for="MeetingMinute.MeetingWithID" class="form-select">
                <option value="">Select a Meeting Attendee</option>
                @foreach (var user in Model.Users)
                {
                    <option value="@user.UserID">@user.FullName</option>
                }
            </select>
            <span asp-validation-for="MeetingMinute.MeetingWithID" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="meetingDate">Meeting Date</label>
            <input type="date" class="form-control" asp-for="MeetingMinute.MeetingDate" />
            <span asp-validation-for="MeetingMinute.MeetingDate" class="text-danger"></span>
        </div>

        <div class="form-group">
            <label for="minutesText">Minutes</label>
            <textarea class="form-control" asp-for="MeetingMinute.MinutesText"></textarea>
            <span asp-validation-for="MeetingMinute.MinutesText" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Add Minutes</button>
        <button type="button" class="btn btn-secondary" onclick="populateFields()">Populate</button>
        <button type="button" class="btn btn-danger" onclick="clearFields()">Clear</button>
    </form>

    <div class="mt-3">
        <a asp-page="/BusinessPartner/BusinessPartner_Dashboard" class="btn btn-info">🔙 Return to Dashboard</a>
    </div>

    <script>
        function populateFields() {
            document.getElementById("businessPartnerID").value = "2";
            document.getElementById("representativeID").value = "3";
            document.getElementById("meetingWithID").value = "4";
            document.getElementById("meetingDate").value = "2024-02-21";
            document.getElementById("minutesText").value = "Discussed last steps";
        }

        function clearFields() {
            document.getElementById("businessPartnerID").value = "";
            document.getElementById("representativeID").value = "";
            document.getElementById("meetingWithID").value = "";
            document.getElementById("meetingDate").value = "";
            document.getElementById("minutesText").value = "";
        }
    </script>
</div>
