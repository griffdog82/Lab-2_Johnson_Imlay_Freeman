@page "{grantID?}"
@model Lab1_Part3_Johnson_Imlay.Pages.BusinessPartner.ViewGrantsModel
@{
    ViewData["Title"] = "Available Grants";
}

<div class="container mt-4">
    <h2 class="mb-3">💰 Available Grants</h2>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Grant Name</th>
                <th>Category</th>
                <th>Funding Source</th>
                <th>Submission Date</th>
                <th>Award Date</th>
                <th>Amount ($)</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var grant in Model.Grants)
            {
                <tr>
                    <td>@grant.GrantName</td>
                    <td>@grant.Category</td>
                    <td>@grant.FundingSource</td>
                    <td>@grant.SubmissionDate.ToString("yyyy-MM-dd")</td>
                    <td>@(grant.AwardDate?.ToString("yyyy-MM-dd") ?? "N/A")</td>
                    <td>@grant.Amount.ToString("C")</td>
                    <td>
                        <span class="badge @(grant.Status == "Approved" ? "bg-success" : grant.Status == "Pending" ? "bg-warning text-dark" : "bg-danger")">
                            @grant.Status
                        </span>
                    </td>
                    <td>
                        <a asp-page="ViewGrants" asp-route-grantID="@grant.GrantID" class="btn btn-info btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.SelectedGrant != null)
    {
        <div class="card mt-4">
            <div class="card-header bg-info text-white">
                <strong>📄 Grant Details</strong>
            </div>
            <div class="card-body">
                <h5 class="card-title">Grant Name: @Model.SelectedGrant.GrantName</h5>
                <h6 class="card-subtitle mb-2 text-muted">Category: @Model.SelectedGrant.Category</h6>
                <h6 class="card-subtitle mb-2 text-muted">Funding Source: @Model.SelectedGrant.FundingSource</h6>
                <h6 class="card-subtitle mb-2 text-muted">Submission Date: @Model.SelectedGrant.SubmissionDate.ToString("yyyy-MM-dd")</h6>
                <h6 class="card-subtitle mb-2 text-muted">Award Date: @(Model.SelectedGrant.AwardDate?.ToString("yyyy-MM-dd") ?? "N/A")</h6>
                <h6 class="card-subtitle mb-2 text-muted">Amount: @Model.SelectedGrant.Amount.ToString("C")</h6>
                <h6 class="card-subtitle mb-2 text-muted">Status: @Model.SelectedGrant.Status</h6>
            </div>
        </div>
    }
</div>
