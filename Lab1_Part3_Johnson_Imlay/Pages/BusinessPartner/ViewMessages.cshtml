@page
@model Lab1_Part3_Johnson_Imlay.Pages.Admin.Messages.ViewMessagesModel
@{
    ViewData["Title"] = "View Messages";
}

<div class="container mt-4">
    <h2 class="mb-3">📩 Inbox</h2>

    <div class="mb-3">
        <label for="senderFilter" class="form-label">Filter by Sender:</label>
        <form method="get" class="d-flex">
            <select name="senderFilter" id="senderFilter" class="form-select me-2" onchange="this.form.submit()">
                <option value="">All Senders</option>
                @foreach (var sender in Model.MsgSenders)
                {
                    <option value="@sender.UserAccountID" selected="@(Model.FilteredSenderID == sender.UserAccountID ? "selected" : null)">
                        @sender.DisplayName
                    </option>
                }
            </select>
            <noscript><button type="submit" class="btn btn-primary">Filter</button></noscript>
        </form>
    </div>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Sender</th>
                <th>Subject</th>
                <th>Received</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var message in Model.MsgList)
            {
                <tr>
                    <td>@message.SenderFullName</td>
                    <td>@message.Subject</td>
                    <td>@message.SentTime.ToString("g")</td>
                    <td>
                        <a asp-page="ViewMessages" asp-route-messageId="@message.MsgID" class="btn btn-info btn-sm">View</a>
                        <a asp-page="ComposeMessage" asp-route-replyTo="@message.MsgID" class="btn btn-primary btn-sm">Reply</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a asp-page="ComposeMessage" class="btn btn-success">📩 New Message</a>

    @if (Model.OpenMessage != null)
    {
        <div class="card mt-4">
            <div class="card-header bg-info text-white">
                <strong>📨 Message Details</strong>
            </div>
            <div class="card-body">
                <h5 class="card-title">@Model.OpenMessage.Subject</h5>
                <h6 class="card-subtitle mb-2 text-muted">From: @Model.OpenMessage.SenderFullName</h6>
                <p class="card-text">@Model.OpenMessage.BodyContent</p>
                <p><small class="text-muted">Received: @Model.OpenMessage.SentTime.ToString("f")</small></p>
                <a asp-page="ComposeMessage" asp-route-replyTo="@Model.OpenMessage.MsgID" class="btn btn-primary">Reply</a>
            </div>
        </div>
    }
</div>
