@page "{minuteID?}"
@model Lab1_Part3_Johnson_Imlay.Pages.BusinessPartner.ViewMeetingMinutesModel
@{
    ViewData["Title"] = "View Meeting Minutes";
}

<div class="container mt-4">
    <h2 class="mb-3">📝 Meeting Minutes</h2>

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>Meeting Date</th>
                <th>Representative</th>
                <th>Meeting With</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var meeting in Model.MeetingMinutes)
            {
                <tr>
                    <td>@meeting.MeetingDate.ToString("yyyy-MM-dd")</td>
                    <td>@meeting.RepresentativeID</td>
                    <td>@meeting.MeetingWithID</td>
                    <td>
                        <a asp-page="ViewMeetingMinutes" asp-route-minuteID="@meeting.MinuteID" class="btn btn-info btn-sm">View</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (Model.SelectedMeetingMinute != null)
    {
        <div class="card mt-4">
            <div class="card-header bg-info text-white">
                <strong>📄 Meeting Details</strong>
            </div>
            <div class="card-body">
                <h5 class="card-title">Meeting Date: @Model.SelectedMeetingMinute.MeetingDate.ToString("yyyy-MM-dd")</h5>
                <h6 class="card-subtitle mb-2 text-muted">Representative ID: @Model.SelectedMeetingMinute.RepresentativeID</h6>
                <h6 class="card-subtitle mb-2 text-muted">Meeting With ID: @Model.SelectedMeetingMinute.MeetingWithID</h6>
                <p class="card-text">@Model.SelectedMeetingMinute.MinutesText</p>
            </div>
        </div>
    }
</div>
